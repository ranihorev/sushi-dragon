{
  "expo": {
    "name": "Sushi Dragon",
    "slug": "sushi-dragon",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sushidragon",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "owner": "ranih",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b2a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sushidragon.app",
      "requireFullScreen": true,
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": ["iCloud.com.sushidragon"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.com.sushidragon"],
        "com.apple.developer.icloud-services": ["CloudDocuments"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "So you can record a word in your own voice for the dragon to say."
      }
    },
    "android": {
      "package": "com.sushidragon.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d1b2a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1b2a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93c9d8d4-52e0-40d8-a7da-ac75051fb4d0"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/93c9d8d4-52e0-40d8-a7da-ac75051fb4d0"
    }
  }
}
