{
  "name": "sushi_dragon",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "expo": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eas-cli": "^21.4.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && expo lint && vitest run",
    "ship:ios": "pnpm check && scripts/ship.sh build --platform ios --profile production --non-interactive --auto-submit-with-profile production",
    "ship:beta": "pnpm check && scripts/ship.sh build --platform ios --profile beta --non-interactive --auto-submit-with-profile production",
    "ship:update": "pnpm check && eas update --channel preview --platform ios --auto",
    "ship:ipad": "scripts/ship.sh build --platform ios --profile preview --non-interactive",
    "ship:device": "scripts/ship.sh device:create",
    "ship:update:prod": "pnpm check && eas update --channel production --platform ios --auto"
  },
  "private": true,
  "packageManager": "pnpm@10.11.0"
}
